# Environment variables / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.venv/
env/
ENV/

# Alembic (keep migrations, ignore local sqlite if any)
*.sqlite3

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# Docker
*.pid
docker-compose.override.aws-test.yml

# Lightsail Container Service: containers.json lleva JWT_SECRET,
# FTP_CREDENTIAL_KEY y la contraseña de la RDS en texto plano (son las
# env vars que Lightsail exige inline, no hay soporte nativo de secrets
# file). Nunca debe subirse al repo. Ver containers.example.json para la
# plantilla sin secretos.
containers.json
endpoint.json

# Archivos de telemetria (.dat): un .dat real de cliente en la maquina de
# alguien del equipo no debe subirse por accidente. Los fixtures de prueba
# de backend/tests/ son datos generados internamente y si van al repo.
*.dat
!backend/tests/fixtures/*.dat
