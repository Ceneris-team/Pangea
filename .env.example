# Copia este archivo a .env y ajusta los valores si tu entorno local difiere.
# NUNCA subas el .env real (ya está en .gitignore).

# Si usas docker-compose (docker compose up -d db redis), estos valores
# ya coinciden con las credenciales definidas ahí. docker-compose.yml
# publica Postgres en el puerto 5433 de tu PC, no en el 5432.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/pangea_dev
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/pangea_test
# HT-11: cuenta independiente sin privilegios; DATABASE_URL queda para migraciones.
# Tras migrar, crear esta cuenta con backend/scripts/aprovisionar_auditoria.py.
DATABASE_RUNTIME_URL=postgresql+psycopg2://pangea_runtime:CAMBIAR_ANTES_DE_USAR@localhost:5433/pangea_dev
# Misma cuenta dentro de Docker; la dirección db no se usa desde el host.
DATABASE_CONTAINER_RUNTIME_URL=postgresql+psycopg2://pangea_runtime:CAMBIAR_ANTES_DE_USAR@db:5432/pangea_dev
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3
RATELIMIT_STORAGE_URL=redis://localhost:6379/1

# El código lee JWT_SECRET (app/security/jwt_auth.py). Complétala: vacía,
# las sesiones se firmarían con una clave vacía.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Obligatoria: vacía, el backend no arranca (Fernet("") falla al importar).
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FTP_CREDENTIAL_KEY=

# URL del backend que consume el frontend (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000

# HU 02 - Gestionar contraseña: URL del frontend usada para armar el enlace
# de recuperación que se envía por correo.
FRONTEND_URL=http://localhost:5173

# HU 02 - SMTP para el correo de recuperación de contraseña. Si se deja
# vacío, el enlace solo se registra en el log del backend (modo desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@pangea.local

# HT-14: remitente verificado en SES API v2. Credenciales por rol IAM
# o mediante la cadena estándar AWS; nunca almacenarlas en el repositorio.
SES_REGION=us-east-1
SES_FROM_EMAIL=
# En local se permite enviar exclusivamente a este buzón. Vacío en producción.
SES_TEST_RECIPIENT=
SES_CONFIGURATION_SET=
SES_MAX_RETRIES=5
SES_RETRY_BASE_SECONDS=10
SES_RETRY_MAX_SECONDS=600
# Opcional: clave Fernet exclusiva para credenciales de bienvenida. Sin ella
# se deriva una clave de propósito distinto desde FTP_CREDENTIAL_KEY.
NOTIFICATION_CREDENTIAL_KEY=

# HT-06 (PP-127) - Object Storage compatible con S3 (Lightsail bucket).
# Guarda respaldos (PP-129), y a futuro .dat crudos y exportaciones (HU33).
# Si se dejan vacías, el job de respaldo falla con un error claro (no se
# necesitan para desarrollo local salvo que pruebes el respaldo).
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# HT-06 (PP-129) - Respaldo extendido semanal cifrado.
# Passphrase para cifrar/descifrar el dump (openssl AES-256). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKUP_ENCRYPTION_KEY=
# Opcionales (tienen default en código): carpeta en el bucket y retención.
BACKUP_PREFIX=respaldos/
BACKUP_RETENTION_DAYS=365

# HU33 / HT-17: bucket PRIVADO de exportaciones, separado del frontend público.
# Las credenciales se resuelven con AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# o el rol de ejecución. No se guardan URLs firmadas en la base de datos.
EXPORT_S3_BUCKET=
EXPORT_S3_REGION=us-east-1
EXPORT_S3_ENDPOINT_URL=
EXPORT_MAX_DAYS=31
EXPORT_MAX_ROWS=1000000
EXPORT_MAX_BYTES=104857600
EXPORT_CHUNK_ROWS=2000
EXPORT_MAX_ACTIVE_PER_USER=2
EXPORT_TTL_HOURS=24
