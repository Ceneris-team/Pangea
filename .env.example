# Copia este archivo a .env y ajusta los valores si tu entorno local difiere.
# NUNCA subas el .env real (ya está en .gitignore).

# Si usas docker-compose (docker-compose up -d db redis), estos valores
# ya coinciden con las credenciales definidas ahí.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pangea_dev
REDIS_URL=redis://localhost:6379/0

# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FTP_CREDENTIAL_KEY=

# URL del backend que consume el frontend (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000

# HU 02 - Gestionar contraseña: URL del frontend usada para armar el enlace
# de recuperación que se envía por correo.
FRONTEND_URL=http://localhost:5173

# HU 02 - SMTP para el correo de recuperación de contraseña. Si se deja
# vacío, el enlace solo se registra en el log del backend (modo desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@pangea.local

# HT-06 (PP-127) - Object Storage compatible con S3 (Lightsail bucket).
# Guarda respaldos (PP-129), y a futuro .dat crudos y exportaciones (HU33).
# Si se dejan vacías, el job de respaldo falla con un error claro (no se
# necesitan para desarrollo local salvo que pruebes el respaldo).
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# HT-06 (PP-129) - Respaldo extendido semanal cifrado.
# Passphrase para cifrar/descifrar el dump (openssl AES-256). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKUP_ENCRYPTION_KEY=
# Opcionales (tienen default en código): carpeta en el bucket y retención.
BACKUP_PREFIX=respaldos/
BACKUP_RETENTION_DAYS=365
