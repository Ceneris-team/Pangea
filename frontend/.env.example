# Copiar a .env (no se commitea) y completar con los valores reales.

# URL base de la API. Por defecto usa http://127.0.0.1:8000 (ver services/api.ts).
# VITE_API_BASE_URL=http://127.0.0.1:8000

# HU22: API key de Google Maps Platform (Maps JavaScript API), restringida
# por dominio en Google Cloud Console. Pedirla al equipo, no inventarla.
VITE_GOOGLE_MAPS_API_KEY=
